#!/usr/bin/env bash
set -Eeuo pipefail
if (($# < 1)); then
  echo 'Uso: dev-build COMANDO [ARGUMENTOS...]' >&2
  echo 'Ex.: dev-build ./gradlew assembleDebug --no-daemon' >&2
  exit 2
fi
# Valores proprios para builds; nao altera configuracao global do usuario.
export GOMAXPROCS="${GOMAXPROCS:-8}"
export CARGO_BUILD_JOBS="${CARGO_BUILD_JOBS:-8}"
export CMAKE_BUILD_PARALLEL_LEVEL="${CMAKE_BUILD_PARALLEL_LEVEL:-8}"
exec "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/dev-run" build "$@"
